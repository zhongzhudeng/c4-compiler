// This file includes possible token kinds in a form suitable for usage via
// preprocessor. Include this header after defining the following macro:
//   #define KIND_ACTION(KD, STR) ...

#define KEYWORD_ACTION(KND, STR) KIND_ACTION(KND, "keyword")

#include "KeyWords.def"

#undef KEYWORD_ACTION

// Identifier
KIND_ACTION(TkIdentifier, "identifier")

// punctuator
KIND_ACTION(TkExclaim, "punctuator")                  // "!"
KIND_ACTION(TkExclaimequal, "punctuator")             // "!="
KIND_ACTION(TkHash, "punctuator")                     // "#"
KIND_ACTION(TkHashhash, "punctuator")                 // "##"
KIND_ACTION(TkPercent, "punctuator")                  // "%"
KIND_ACTION(TkPercentcolon, "punctuator")             // "%:"
KIND_ACTION(TkPercentcolonpercentcolon, "punctuator") // "%:%:"
KIND_ACTION(TkPercentequal, "punctuator")             // "%="
KIND_ACTION(TkPercentgreater, "punctuator")           // "%>"
KIND_ACTION(TkAmp, "punctuator")                      // "&"
KIND_ACTION(TkAmpamp, "punctuator")                   // "&&"
KIND_ACTION(TkAmpequal, "punctuator")                 // "&="
KIND_ACTION(TkLparen, "punctuator")                   // "("
KIND_ACTION(TkRparen, "punctuator")                   // ")"
KIND_ACTION(TkStar, "punctuator")                     // "*"
KIND_ACTION(TkStarequal, "punctuator")                // "*="
KIND_ACTION(TkPlus, "punctuator")                     // "+"
KIND_ACTION(TkPlusplus, "punctuator")                 // "++"
KIND_ACTION(TkPlusequal, "punctuator")                // "+="
KIND_ACTION(TkComma, "punctuator")                    // ","
KIND_ACTION(TkMinus, "punctuator")                    // "-"
KIND_ACTION(TkMinusminus, "punctuator")               // "--"
KIND_ACTION(TkMinusequal, "punctuator")               // "-="
KIND_ACTION(TkArrow, "punctuator")                    // "->"
KIND_ACTION(TkPeriod, "punctuator")                   // "."
KIND_ACTION(TkEllipsis, "punctuator")                 // "..."
KIND_ACTION(TkSlash, "punctuator")                    // "/"
KIND_ACTION(TkSlashequal, "punctuator")               // "/="
KIND_ACTION(TkColon, "punctuator")                    // ":"
KIND_ACTION(TkColongreater, "punctuator")             // ":>"
KIND_ACTION(TkSemicolon, "punctuator")                // ";"
KIND_ACTION(TkLess, "punctuator")                     // "<"
KIND_ACTION(TkLesspercent, "punctuator")              // "<%"
KIND_ACTION(TkLesscolon, "punctuator")                // "<:"
KIND_ACTION(TkLessless, "punctuator")                 // "<<"
KIND_ACTION(TkLesslessequal, "punctuator")            // "<<="
KIND_ACTION(TkLessequal, "punctuator")                // "<="
KIND_ACTION(TkEqual, "punctuator")                    // "="
KIND_ACTION(TkEqualequal, "punctuator")               // "=="
KIND_ACTION(TkGreater, "punctuator")                  // ">"
KIND_ACTION(TkGreaterequal, "punctuator")             // ">="
KIND_ACTION(TkGreatergreater, "punctuator")           // ">>"
KIND_ACTION(TkGreatergreaterequal, "punctuator")      // ">>="
KIND_ACTION(TkQuestion, "punctuator")                 // "?"
KIND_ACTION(TkLsquare, "punctuator")                  // "["
KIND_ACTION(TkRsquare, "punctuator")                  // "]"
KIND_ACTION(TkCaret, "punctuator")                    // "^"
KIND_ACTION(TkCaretequal, "punctuator")               // "^="
KIND_ACTION(TkLbrace, "punctuator")                   // "{"
KIND_ACTION(TkPipe, "punctuator")                     // "|"
KIND_ACTION(TkPipeequal, "punctuator")                // "|="
KIND_ACTION(TkPipepipe, "punctuator")                 // "||"
KIND_ACTION(TkRbrace, "punctuator")                   // "}"
KIND_ACTION(TkTild, "punctuator")                     // "~"

// decimal-constants,0 and character-constants
KIND_ACTION(TkConstant, "constant")
KIND_ACTION(TkStringLiteral, "string-literal")

KIND_ACTION(TkEoi, "end-of-input")
