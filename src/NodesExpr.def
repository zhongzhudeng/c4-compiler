#ifndef ABSTRACT_EXPR
#  define ABSTRACT_EXPR(Type) Type
#endif

#ifndef EXPR_RANGE
#  define EXPR_RANGE(Base, First, Last)
#endif

#ifndef LAST_EXPR_RANGE
#  define LAST_EXPR_RANGE(Base, First, Last) EXPR_RANGE(Base, First, Last)
#endif

#ifndef IDENTIFIER
#  define IDENTIFIER(Type, Base) EXPR(Type, Base)
#endif
IDENTIFIER(Identifier, Expr)
#undef IDENTIFIER

#ifndef CONSTANT
#  define CONSTANT(Type, Base) EXPR(Type, Base)
#endif
CONSTANT(Constant, Expr)
#undef CONSTANT

#ifndef STRINGLITERAL
#  define STRINGLITERAL(Type, Base) EXPR(Type, Base)
#endif
STRINGLITERAL(StringLiteral, Expr)
#undef STRINGLITERAL

#ifndef PAREN
#  define PAREN(Type, Base) EXPR(Type, Base)
#endif
PAREN(Paren, Expr)
#undef PAREN

#ifndef CONDITIONAL
#  define CONDITIONAL(Type, Base) EXPR(Type, Base)
#endif
CONDITIONAL(Conditional, Expr)
#undef CONDITIONAL

#ifndef BINARY
#  define BINARY(Type, Base) EXPR(Type, Base)
#endif
BINARY(Binary, Expr)
#undef BINARY

#ifndef UNARY
#  define UNARY(Type, Base) EXPR(Type, Base)
#endif
UNARY(Unary, Expr)
#undef UNARY

#ifndef SIZEOF
#  define SIZEOF(Type, Base) EXPR(Type, Base)
#endif
SIZEOF(Sizeof, Expr)
#undef SIZEOF

#ifndef SIZEOFTYPE
#  define SIZEOFTYPE(Type, Base) EXPR(Type, Base)
#endif
SIZEOFTYPE(SizeofType, Expr)
#undef SIZEOFTYPE

#ifndef ARRAYSUBSCRIPT
#  define ARRAYSUBSCRIPT(Type, Base) EXPR(Type, Base)
#endif
ARRAYSUBSCRIPT(ArraySubscript, Expr)
#undef ARRAYSUBSCRIPT

#ifndef FUNCTIONCALL
#  define FUNCTIONCALL(Type, Base) EXPR(Type, Base)
#endif
FUNCTIONCALL(FunctionCall, Expr)
#undef FUNCTIONCALL

#ifndef MEMBER
#  define MEMBER(Type, Base) EXPR(Type, Base)
#endif
MEMBER(Member, Expr)
#undef MEMBER

LAST_EXPR_RANGE(Expr, Identifier, Member)

#undef EXPR
#undef EXPR_RANGE
#undef LAST_EXPR_RANGE
#undef ABSTRACT_EXPR