#pragma once

#define TK(kind) case TK_##kind:
#define PRIMARY_NO_LPAREN TK(IDENTIFIER) TK(CONSTANT) TK(STRING_LITERAL)
#define PRIMARY PRIMARY_NO_LPAREN TK(LPAREN)
#define UNARY_OP_NO_SIZEOF TK(AMP) TK(STAR) TK(MINUS) TK(EXCLAIM)
#define UNARY_OP UNARY_OP_NO_SIZEOF TK(SIZEOF)
#define TYPENAME TK(VOID) TK(CHAR) TK(INT)
#define BINARY_OP                                                              \
  TK(STAR)                                                                     \
  TK(PLUS)                                                                     \
  TK(MINUS) TK(LESS) TK(EQUALEQUAL) TK(EXCLAIMEQUAL) TK(AMPAMP) TK(PIPEPIPE)
#define EXPR_FOLLOW TK(RPAREN) TK(RSQUARE) TK(COLON) TK(COMMA)
#define COND_FOLLOW EXPR_FOLLOW
#define BINARY_FOLLOW EXPR_FOLLOW TK(QUESTION)
#define CAST_FOLLOW BINARY_OP BINARY_FOLLOW TK(EQUAL)
#define UNARY_FOLLOW CAST_FOLLOW
#define POST_FOLLOW UNARY_FOLLOW
#define PRIMARY_FOLLOW POST_FOLLOW

#define STRUCT_SPECIFIER TK(STRUCT)
#define TYPE_SPECIFIER TK(VOID) TK(CHAR) TK(INT) STRUCT_SPECIFIER
#define DECLARATION_SPECIFIER TYPE_SPECIFIER
#define DECLARATION DECLARATION_SPECIFIER

#define DIRECT_DECLARATOR TK(IDENTIFIER) TK(LPAREN)
#define DECLARATOR DIRECT_DECLARATOR TK(STAR)
#define STRUCT_DECLARATOR DECLARATOR
#define SPECIFIER_QUALIFIER_LIST TYPE_SPECIFIER
#define STRUCT_DECLARATION SPECIFIER_QUALIFIER_LIST

#define DIRECT_ABSTRACT_DECLARATOR TK(LPAREN)
#define ABSTRACT_DECLARATOR TK(STAR) DIRECT_ABSTRACT_DECLARATOR


#define PARAMETER_LIST_FOLLOW TK(RPAREN)
#define PARAMETER_DECLARATION_FOLLOW TK(COMMA) PARAMETER_LIST_FOLLOW

#define STRUCT_DECLARATOR_FOLLOW TK(COMMA) TK(SEMICOLON)
#define DECLARATOR_FOLLOW STRUCT_DECLARATOR_FOLLOW PARAMETER_LIST_FOLLOW
#define DECLARATION_SPECIFIER_FOLLOW DECLARATOR TK(SEMICOLON) PARAMETER_DECLARATION_FOLLOW
#define DIRECT_DECLARATOR_FOLLOW DECLARATOR_FOLLOW
#define TYPE_SPECIFIER_FOLLOW DECLARATION_SPECIFIER DECLARATION_SPECIFIER_FOLLOW
#define STRUCT_SPECIFIER_FOLLOW TYPE_SPECIFIER_FOLLOW